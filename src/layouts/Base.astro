---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "罗祥的工具库与数字生活：收录好用工具，记录折腾过程，留一点想法。",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

const nav = [
  { href: "/", label: "首页" },
  { href: "/tools/", label: "工具库" },
  { href: "/articles/", label: "文章" },
  { href: "/about/", label: "关于" },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? (path === "/" ? "page" : undefined)
  : path.startsWith(href) ? "page" : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="1971.xin" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <script is:inline>
      // 默认暗色（本站视觉以暗色为主），localStorage 可覆盖为亮色
      (function () {
        var saved = localStorage.getItem("theme");
        document.documentElement.dataset.theme = saved || "dark";
      })();
    </script>
  </head>

  <body>
    <header class="site-head">
      <div class="wrap">
        <a href="/" class="logo">
          <span class="glyph">1</span>
          <span>1971.xin</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a class="nav-link" href={item.href} aria-current={current(item.href)}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>© 2026 · 罗祥 · 站在互联网上</p>
        <p class="foot-mono">Astro · Cloudflare Pages · git push 即上线</p>
      </div>
    </footer>

    <script>
      // 主题切换
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      });

      // 滚动渐显：给带 .rv 的元素加 .in，用 data-d 控制错峰延迟
      const items = document.querySelectorAll(".rv");
      if ("IntersectionObserver" in window && items.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        items.forEach((el) => {
          const d = el.getAttribute("data-d");
          if (d) el.style.setProperty("--d", d);
          io.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add("in"));
      }
    </script>

    <style>
      .theme-toggle .icon-sun { display: none; }
      [data-theme="light"] .theme-toggle .icon-sun { display: block; }
      [data-theme="light"] .theme-toggle .icon-moon { display: none; }
    </style>
  </body>
</html>
