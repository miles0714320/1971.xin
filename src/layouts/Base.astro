---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "罗祥的工具库与数字生活：收录好用工具，记录折腾过程，留一点想法。",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

const nav = [
  { href: "/", label: "首页" },
  { href: "/tools/", label: "工具库" },
  { href: "/articles/", label: "文章" },
  { href: "/about/", label: "关于" },
];
const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? (path === "/" ? "page" : undefined)
  : path.startsWith(href) ? "page" : undefined;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="1971.xin" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <script is:inline>
      // 默认亮色（用户 2026-10-25 明确要求：打开先看到"正常模式"）。
      // 用户手动切到暗色后，localStorage 记住该选择，后续访问沿用。
      (function () {
        var saved = localStorage.getItem("theme");
        document.documentElement.dataset.theme = saved === "dark" ? "dark" : "light";
        // 渐进增强：只有真正支持 IntersectionObserver 才启用滚动渐显的初始隐藏，
        // 否则内容保持默认可见（JS 禁用、老浏览器、打印都不会得到空白页）。
        if ("IntersectionObserver" in window) {
          document.documentElement.classList.add("js-anim");
        }
      })();
    </script>
  </head>

  <body>
    <header class="site-head">
      <div class="wrap">
        <a href="/" class="logo">
          <span>1971.xin</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a class="nav-link" href={item.href} aria-current={current(item.href)}>{item.label}</a>
          ))}
          <button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题（当前：亮色，点击转暗色）" id="theme-btn">
            <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <p>© 2026 · 罗祥 · 站在互联网上</p>
        <p class="foot-mono">Astro · Cloudflare Pages · git push 即上线</p>
      </div>
    </footer>

    <script>
      // 主题切换
      const themeBtn = document.querySelector(".theme-toggle");
      function syncThemeLabel() {
        if (!themeBtn) return;
        const isDark = document.documentElement.dataset.theme === "dark";
        themeBtn.title = isDark
          ? "切换深浅色主题（当前：暗色，点击转亮色）"
          : "切换深浅色主题（当前：亮色，点击转暗色）";
      }
      themeBtn?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
        syncThemeLabel();
      });
      syncThemeLabel();

      // 滚动渐显：给带 .rv 的元素加 .in，用 data-d 控制错峰延迟。
      // threshold 用 0 而非 0.12：元素刚进入视口就触发，避免高元素迟迟不显示。
      const items = document.querySelectorAll(".rv");
      if ("IntersectionObserver" in window && items.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0, rootMargin: "0px 0px -4% 0px" }
        );
        items.forEach((el) => {
          const d = el.getAttribute("data-d");
          if (d) el.style.setProperty("--d", d);
          io.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add("in"));
      }
    </script>

    <style>
      /* 图标表示"点击后会切到的模式"：亮色时显示月亮，暗色时显示太阳 */
      .theme-toggle .icon-sun { display: none; }
      [data-theme="dark"] .theme-toggle .icon-sun { display: block; }
      [data-theme="dark"] .theme-toggle .icon-moon { display: none; }
    </style>

    <!-- ── 访客聊天：点击才加载 ──────────────────────────────
         SDK（trtc.io/knocket-sdk/sdk.js）原始 3.24 MB / Brotli 874 KB，
         全站自动加载会把 24 KB 的首屏拖垮。这里只放一个纯 CSS 轻量按钮，
         用户点击后才注入脚本；未交互访客零第三方请求。
         加载完成后由 SDK 自带的挂件接管入口（见下方 handoff 逻辑）。
         is:inline 保证 Astro 原样输出，不参与打包。 -->
    <button id="contact-launcher" type="button" aria-label="打开在线聊天" title="在线聊聊">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      <span>聊聊</span>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById("contact-launcher");
        if (!btn) return;
        var label = btn.querySelector("span");
        var SDK_URL = "https://trtc.io/knocket-sdk/sdk.js?identifier=2e613a58a060536fbd";
        var injected = false;

        // SDK 就绪后自动展开聊天，避免用户点两次。
        // showChat 是 SDK 的 React 组件挂载后才写到 contactWidget 上的，故短轮询等它。
        window.ContactWidgetOnReady = function () {
          var tries = 0;
          var timer = setInterval(function () {
            var w = window.contactWidget;
            if (w && typeof w.showChat === "function") {
              w.showChat();
              btn.remove(); // 官方挂件已就绪，撤掉自建入口
              clearInterval(timer);
            } else if (++tries > 20) {
              clearInterval(timer); // 兜底：官方挂件自身的按钮仍可点
            }
          }, 150);
        };

        btn.addEventListener("click", function () {
          var w = window.contactWidget;
          if (injected) {
            if (w && typeof w.showChat === "function") w.showChat();
            return;
          }
          injected = true;
          btn.disabled = true;
          btn.setAttribute("aria-busy", "true");
          label.textContent = "连接中…";

          var s = document.createElement("script");
          s.src = SDK_URL;
          s.async = true;
          s.onload = function () {
            // 万一 ready 钩子没触发，5 秒后也让官方挂件接管，避免两个入口重叠
            setTimeout(function () { if (btn.isConnected) btn.remove(); }, 5000);
          };
          s.onerror = function () {
            injected = false;
            btn.disabled = false;
            btn.removeAttribute("aria-busy");
            label.textContent = "重试";
          };
          document.body.appendChild(s);
        });
      })();
    </script>
  </body>
</html>
