---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const tools = (await getCollection("tools")).sort((a, b) => a.data.order - b.data.order);

// 按分类分组，保持首次出现的顺序
const groups = new Map<string, typeof tools>();
for (const tool of tools) {
  const list = groups.get(tool.data.category) ?? [];
  list.push(tool);
  groups.set(tool.data.category, list);
}
---

<Base
  title="工具库 · 1971.xin"
  description="我真实在用的工具集合：AI 与大模型、效率与自动化、开发与折腾。"
>
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-l">
        <p class="eyebrow rv"><span class="pulse"></span>TOOLS · {tools.length} 个收录</p>
        <h1 class="rv" data-d="1">工具库</h1>
        <p class="hero-sub rv" data-d="2">
          这里没有恰饭推荐，只有我<b>真实在用、且愿意继续用</b>的东西。
        </p>
        <p class="hero-sub rv" data-d="2">
          每一条都是自己试过之后留下的。点卡片直达官网。
        </p>
      </div>
      <div class="hero-r rv" data-d="2">
        <div class="demo">
          <div class="demo-bar">
            <span class="demo-dot"></span>
            <span class="demo-dot"></span>
            <span class="demo-dot"></span>
            <span class="demo-title">~/tools — list</span>
          </div>
          <div class="demo-body">
            {[...groups.entries()].map(([cat, list]) => (
              <span class="ln"><span class="p">{cat}</span> <span class="c">({list.length})</span></span>
            ))}
            <span class="ln"></span>
            <span class="ln"><span class="p">$</span> <span class="s">cat 使用心得.md</span></span>
            <span class="ln"><span class="c"># 每一条都亲手试过</span></span>
            <span class="ln"><span class="m">持续更新中…</span> <span class="cur"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {[...groups.entries()].map(([category, list]) => (
    <section class="section wrap" aria-labelledby={`cat-${category}`}>
      <div class="sec-head rv">
        <p class="sec-kicker">{category}</p>
        <h2 id={`cat-${category}`}>{list.length} 个工具</h2>
      </div>
      <div class="tool-grid">
        {list.map((tool, i) => (
          <a class="tool-card rv" data-d={String(i)} href={tool.data.url} target="_blank" rel="noopener">
            <span class="name">{tool.data.name}<span class="arrow" aria-hidden="true">↗</span></span>
            <span class="tagline">{tool.data.tagline}</span>
            <span class="meta">
              <span class="chip">{tool.data.category}</span>
              {tool.data.platform.map((p) => (
                <span class="chip chip-plain">{p}</span>
              ))}
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
