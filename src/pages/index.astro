---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { coverGradient, coverGlyph } from "../utils/cover";

const tools = (await getCollection("tools")).sort((a, b) => a.data.order - b.data.order);
const featured = tools.filter((t) => t.data.featured);

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = articles.slice(0, 6);

const fmt = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="1971.xin · 工具、技术和数字生活">
  <!-- ── Hero：左文案 / 右终端演示 ── -->
  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-l">
        <p class="eyebrow rv" data-d="0"><span class="pulse"></span>ONLINE · 罗祥的个人站</p>
        <h1 class="rv" data-d="1">工具、技术<br />和<em>数字生活</em>。</h1>
        <p class="hero-sub rv" data-d="2">
          收录我<b>真实在用</b>的工具，记录折腾技术的过程，
          顺手留一点没更好去处的想法。
        </p>
        <p class="hero-sub rv" data-d="2">
          没有恰饭，没有软文 —— 每一条都是自己试过之后留下的。
          <b>够用就好。</b>
        </p>
        <div class="hero-cta rv" data-d="3">
          <a class="btn-main" href="/tools/">
            <span>浏览工具库</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn-ghost" href="/articles/">读文章</a>
        </div>
        <p class="hero-trust rv" data-d="4">
          <i>Astro 构建</i><em>·</em><i>Cloudflare 托管</i><em>·</em><i>git push 即上线</i><em>·</em><i>无后端零成本</i>
        </p>
      </div>

      <div class="hero-r rv" data-d="2">
        <div class="demo">
          <div class="demo-bar">
            <span class="demo-dot"></span>
            <span class="demo-dot"></span>
            <span class="demo-dot"></span>
            <span class="demo-title">~/1971.xin — status</span>
          </div>
          <div class="demo-body">
            <span class="ln"><span class="p">$</span> <span class="s">1971.xin --status</span></span>
            <span class="ln"><span class="c">✓</span> <span class="s">站点</span>      <span class="m">在线</span></span>
            <span class="ln"><span class="c">✓</span> <span class="s">工具库</span>    <span class="m">{tools.length} 个收录</span></span>
            <span class="ln"><span class="c">✓</span> <span class="s">文章</span>      <span class="m">{articles.length} 篇</span></span>
            <span class="ln"><span class="c">✓</span> <span class="s">部署</span>      <span class="m">push → 40s</span></span>
            <span class="ln"><span class="c">✓</span> <span class="s">成本</span>      <span class="m">¥0 / 月</span></span>
            <span class="ln"></span>
            <span class="ln"><span class="p">$</span> <span class="s">echo "够用就好"</span></span>
            <span class="ln"><span class="m">够用就好</span> <span class="cur"></span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 精选工具 ── -->
  <section class="section wrap" aria-labelledby="home-tools">
    <div class="sec-head-row">
      <div class="sec-head rv">
        <p class="sec-kicker">TOOLS</p>
        <h2 id="home-tools">在用的工具</h2>
        <p class="sec-sub">自己试过、愿意继续用的东西。点卡片直达官网。</p>
      </div>
      <a class="sec-more rv" data-d="1" href="/tools/">全部 {tools.length} 个 →</a>
    </div>
    <div class="tool-grid">
      {featured.map((tool, i) => (
        <a class="tool-card rv" data-d={String(i)} href={tool.data.url} target="_blank" rel="noopener">
          <span class="name">{tool.data.name}<span class="arrow" aria-hidden="true">↗</span></span>
          <span class="tagline">{tool.data.tagline}</span>
          <span class="meta"><span class="chip">{tool.data.category}</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── 最新文章（封面卡 + 内容流）── -->
  <section class="section wrap" aria-labelledby="home-articles">
    <div class="sec-head-row">
      <div class="sec-head rv">
        <p class="sec-kicker">WRITING</p>
        <h2 id="home-articles">最近在写</h2>
        <p class="sec-sub">踩过的坑、跑通的方案。写下来，主要是为了下次不用重想一遍。</p>
      </div>
      <a class="sec-more rv" data-d="1" href="/articles/">全部 {articles.length} 篇 →</a>
    </div>
    <div class="cover-grid">
      {recent.map((post, i) => (
        <a class="cover-card rv" data-d={String(i)} href={`/articles/${post.id}/`}>
          <div class="cover" style={`background:${coverGradient(post.id)}`}>
            <span class="cover-glyph">{coverGlyph(post.data.title)}</span>
            <span class="cover-cat">ARTICLE</span>
          </div>
          <div class="cc-body">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="meta">
              <span>{fmt(post.data.pubDate)}</span>
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="wrap">
    <div class="cta rv">
      <h2>想找个安静角落聊聊工具和技术？</h2>
      <p>这个域名是我在互联网上的门牌号 —— 收邮件、放东西、记录念头。嫌邮件太重，也可以先从工具库翻起。</p>
      <div class="hero-cta">
        <a class="btn-main" href="mailto:luoxiang@agent.qq.com">
          <span>发封邮件</span>
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn-ghost" href="/about/">关于我</a>
      </div>
    </div>
  </section>
</Base>
